# ==========================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# ==========================================

# MongoDB connection string (the app appends /sih as the database name)
MONGODB_URI=mongodb://localhost:27017

# Port the backend listens on
PORT=8000

# Allowed CORS origin for the deployed frontend (localhost:5173 is always allowed)
CORS_ORIGIN=https://your-frontend.vercel.app

# Secret used to sign JWT access tokens (use a long random string in production)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret

# Cloudinary credentials for profile/team image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Set to "production" in deployed environments (enables secure cookies)
# NODE_ENV=production